# --- 1. The Physics Engine ---

class Task:
    def __init__(self, task_id, features, arrival_time, category):
        self.task_id = task_id
        self.features = np.array(features)
        # Store individual dimensions
        self.complexity = features[0]
        self.length = features[1]
        self.io_intensity = features[2]
        # Calculate Euclidean Distance (The 'Mass')
        self.initial_dist = np.linalg.norm(self.features) 
        
        self.arrival_time = arrival_time
        self.finish_time = None
        self.wait_time = 0
        self.current_s = self.initial_dist
        self.category = category  # Fixed: Proper assignment

class SingularityQueue:
    def __init__(self, capacity=70, gravity=0.035):
        self.capacity = capacity
        self.gravity = gravity
        self.active_tasks = []
        self.finished_tasks = []
        self.horizon_history = []
        self.density_history = []
        self.time_history = []

    def run(self, incoming_tasks, max_ticks=3000):
        current_tick = 0
        while (incoming_tasks or self.active_tasks) and current_tick < max_ticks:
            # Add arriving tasks
            while incoming_tasks and incoming_tasks[0].arrival_time <= current_tick:
                self.active_tasks.append(incoming_tasks.pop(0))

            # Event Horizon (R) shrinks as density increases
            density = len(self.active_tasks)
            R = self.capacity / (density + 1)
            
            self.horizon_history.append(R)
            self.density_history.append(density)
            self.time_history.append(current_tick)

            # Check for 'Capture'
            captured = []
            for task in self.active_tasks:
                age = current_tick - task.arrival_time
                # S(t) = d - (G * t^2)
                task.current_s = task.initial_dist - (self.gravity * (age**2))
                if task.current_s <= R:
                    captured.append(task)

            # Process the task closest to the singularity
            if captured:
                captured.sort(key=lambda x: x.current_s)
                to_process = captured[0]
                to_process.finish_time = current_tick
                to_process.wait_time = current_tick - to_process.arrival_time
                self.finished_tasks.append(to_process)
                self.active_tasks.remove(to_process)

            current_tick += 1

