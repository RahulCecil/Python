class DynamicTask:
    def __init__(self, task_id, features, arrival_time):
        self.task_id = task_id
        self.features = np.array(features)
        self.initial_dist = np.linalg.norm(self.features)
        self.arrival_time = arrival_time
        self.finish_time = None
        self.wait_time = 0

class DynamicSingularityQueue:
    def __init__(self, capacity=40, gravity=0.04):
        self.capacity = capacity
        self.gravity = gravity
        self.active_tasks = []
        self.finished_tasks = []
        self.horizon_history = []
        self.density_history = []

    def run(self, incoming_tasks, total_ticks=1000):
        for tick in range(total_ticks):
            # 1. Check for arriving tasks
            while incoming_tasks and incoming_tasks[0].arrival_time <= tick:
                self.active_tasks.append(incoming_tasks.pop(0))

            # 2. Update Event Horizon (R)
            density = len(self.active_tasks)
            R = self.capacity / (density + 1)
            self.horizon_history.append(R)
            self.density_history.append(density)

            # 3. Update 'S' for all active tasks
            captured = []
            for task in self.active_tasks:
                age = tick - task.arrival_time
                current_s = task.initial_dist - (self.gravity * (age**2))
                if current_s <= R:
                    captured.append((current_s, task))

            # 4. Process the closest captured task
            if captured:
                captured.sort(key=lambda x: x[0])
                _, to_process = captured[0]
                to_process.finish_time = tick
                to_process.wait_time = tick - to_process.arrival_time
                self.finished_tasks.append(to_process)
                self.active_tasks.remove(to_process)

