import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# --- 1. PRESERVED ORIGINAL CLASS STRUCTURE ---

class SingularityQueue:
    def __init__(self, capacity=100, gravity=0.5):
        self.capacity = capacity
        self.gravity = gravity
        self.tasks = []
        # Monitoring lists for the 10k simulation
        self.finished_log = []
        self.horizon_history = []
        self.density_history = []
        self.time_history = []

    def get_event_horizon(self):
        # R shrinks as the queue density increases
        density = len(self.tasks)
        return self.capacity / (density + 1)

    def add_task(self, name, features, virtual_time, category):
        # features = [complexity, length, memory_req, etc.]
        initial_dist = np.linalg.norm(features)
        self.tasks.append({
            "name": name,
            "d_initial": initial_dist,
            "entry_time": virtual_time, # Virtual tick for simulation
            "features": features,
            "category": category       # Categorization for plotting
        })

    def step(self, current_time):
        """Processes the queue by finding tasks that have crossed the horizon."""
        R = self.get_event_horizon()
        
        # Track system state for the dashboard
        self.horizon_history.append(R)
        self.density_history.append(len(self.tasks))
        self.time_history.append(current_time)
        
        # Calculate current 'collapsed distance' S for all tasks
        for task in self.tasks:
            age = current_time - task["entry_time"]
            # S(t) = d - (G * t^2)
            task["S"] = task["d_initial"] - (self.gravity * (age**2))

        # Split tasks into 'Captured' and 'Accretion Disk'
        captured = [t for t in self.tasks if t["S"] <= R]
        accretion_disk = [t for t in self.tasks if t["S"] > R]

        # 1. Process Captured (The Event Horizon)
        if captured:
            # Sort captured tasks so the 'closest' to singularity goes first
            captured.sort(key=lambda x: x["S"])
            processing = captured.pop(0)
            self.tasks = captured + accretion_disk
            
            # Record results
            processing['finish_time'] = current_time
            processing['wait_time'] = current_time - processing['entry_time']
            self.finished_log.append(processing)
            return True

        self.tasks = accretion_disk
        return False

# --- 2. 10,000 TASK SIMULATION SETUP ---

np.random.seed(42)
num_tasks = 10000
# High-pressure arrival: average 1 task every 2 ticks
arrival_times = np.cumsum(np.random.poisson(2, num_tasks))
incoming_tasks = []

# Generate 10k tasks based on requested distribution
for i in range(num_tasks):
    roll = np.random.random()
    if roll < 0.20:
        f = np.random.uniform(1, 15, 3); cat = "Light"
    elif roll < 0.60:
        f = np.random.uniform(20, 50, 3); cat = "Medium"
    elif roll < 0.90:
        f = np.random.uniform(60, 90, 3); cat = "Heavy"
    else:
        f = np.random.uniform(100, 160, 3); cat = "Extra Heavy"
    
    incoming_tasks.append({
        "name": f"Task_{i}", 
        "features": f, 
        "arrival": arrival_times[i], 
        "category": cat
    })

# Initialize Queue (Capacity lowered to 50 to force extreme pressure)
sq = SingularityQueue(capacity=50, gravity=0.04)

current_tick = 0
max_ticks = 50000 # Large buffer for processing

# --- 3. EXECUTION LOOP ---

print(f"Starting simulation for {num_tasks} tasks...")
while (incoming_tasks or sq.tasks) and current_tick < max_ticks:
    # Handle task arrivals
    while incoming_tasks and incoming_tasks[0]['arrival'] <= current_tick:
        t = incoming_tasks.pop(0)
        sq.add_task(t['name'], t['features'], t['arrival'], t['category'])
    
    # Run the physics step
    sq.step(current_tick)
    current_tick += 1

print(f"Simulation ended at tick {current_tick}")

# --- 4. DASHBOARD PLOTTING ---

df = pd.DataFrame(sq.finished_log)
# Unpack features for individual dimension plots
df['Complexity'] = df['features'].apply(lambda x: x[0])
df['Length'] = df['features'].apply(lambda x: x[1])
df['IO'] = df['features'].apply(lambda x: x[2])

colors = {"Light": "#00f2ff", "Medium": "#39ff14", "Heavy": "#ff9900", "Extra Heavy": "#ff0055"}
fig = plt.figure(figsize=(18, 12))
gs = fig.add_gridspec(3, 4)

# ROW 1: Feature Correlations
metrics = [('Complexity', 'Complexity'), ('Length', 'Length'), ('IO', 'IO Intensity'), ('d_initial', 'Aggregate Mass')]
for i, (col, title) in enumerate(metrics):
    ax = fig.add_subplot(gs[0, i])
    for cat, color in colors.items():
        subset = df[df['category'] == cat]
        ax.scatter(subset[col], subset['wait_time'], c=color, label=cat, edgecolors='black', alpha=0.3, s=10)
    ax.set_title(f"Wait vs {title}")
    ax.grid(True, alpha=0.2)
    if i == 0: ax.legend()

# ROW 2: System Pressure (Event Horizon vs Density)
ax_dyn = fig.add_subplot(gs[1, :])
ax_dyn.plot(sq.time_history, sq.horizon_history, color='black', linewidth=0.5, label="Event Horizon (R)")
ax_dyn.fill_between(range(len(sq.density_history)), sq.density_history, color='orange', alpha=0.2, label="Queue Density")
ax_dyn.set_title("Extreme Load Dynamics: 10,000 Tasks")
ax_dyn.set_xlabel("Ticks")
ax_dyn.legend(loc='upper right')
ax_dyn.grid(True, alpha=0.2)

# ROW 3: Latency Map (Arrival vs Finish)
ax_lag = fig.add_subplot(gs[2, :])
ax_lag.scatter(df["entry_time"], df["finish_time"], c=df["wait_time"], cmap='plasma', s=1)
ax_lag.plot([0, current_tick], [0, current_tick], 'r--', alpha=0.6, label="Instant Processing")
ax_lag.set_title("Global Latency Map: Throughput at Saturation")
ax_lag.set_xlabel("Arrival Tick")
ax_lag.set_ylabel("Finish Tick")
ax_lag.legend()

plt.tight_layout()
plt.show()
